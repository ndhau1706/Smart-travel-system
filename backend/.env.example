# Application
APP_NAME=Smart Travel System API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./smart_travel.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_travel

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email / OTP (Brevo SMTP)
# (Required if you enable OTP-based register/reset password flows)
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Smart Travel

BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# OTP settings
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT_PER_HOUR=5
