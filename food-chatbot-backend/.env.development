# =============================================================================
# Food Chatbot Backend - Development Environment Configuration
# =============================================================================
# Local development settings with DEBUG enabled
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true  # Enable debug mode for development

# Groq Cloud API Configuration
# Add your development API keys here
GROQ_API_KEYS=gsk_your_dev_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_SECONDARY_FALLBACK_MODEL=mixtral-8x7b-32768

# JWT Authentication - Use simple key for development
# WARNING: Change this in production!
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60  # Longer expiry for dev convenience
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
DATABASE_PATH=./database/chatbot.db

# Search & Indexing Configuration
FAISS_INDEX_PATH=./data/faiss_index
BM25_INDEX_PATH=./data/bm25_index.pkl
VECTOR_DIMENSION=384

# Hybrid Search Weights
SEMANTIC_WEIGHT=0.6
BM25_WEIGHT=0.4

# Ranking Configuration
MAX_RESULTS=10
DISTANCE_THRESHOLD=10.0

# Cache Configuration
CACHE_TTL=60  # Shorter cache for development
CACHE_MAX_SIZE=100

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Language Configuration
DEFAULT_LANGUAGE=vi
SUPPORTED_LANGUAGES=vi,en

# Data Source
RESTAURANTS_JSON_PATH=./hcm_restaurants_chatbot.json

# Logging - Verbose for development
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Rate limiting - More permissive for development
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_CHAT_PER_MINUTE=100
