# =============================================================================
# Food Chatbot Backend - Production Environment Configuration
# =============================================================================
# Production settings with security hardening
# IMPORTANT: Replace all placeholder values before deployment!
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false  # CRITICAL: Never enable DEBUG in production!

# Groq Cloud API Configuration
# Use multiple API keys for load balancing and redundancy
GROQ_API_KEYS=gsk_prod_key_1,gsk_prod_key_2,gsk_prod_key_3
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_SECONDARY_FALLBACK_MODEL=mixtral-8x7b-32768

# JWT Authentication - CRITICAL: Use strong secret!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_64_CHARS_OR_MORE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15  # Short expiry for security
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For production, consider PostgreSQL instead of SQLite
DATABASE_PATH=/var/lib/chatbot/database/chatbot.db

# Search & Indexing Configuration
FAISS_INDEX_PATH=/var/lib/chatbot/data/faiss_index
BM25_INDEX_PATH=/var/lib/chatbot/data/bm25_index.pkl
VECTOR_DIMENSION=384

# Hybrid Search Weights
SEMANTIC_WEIGHT=0.6
BM25_WEIGHT=0.4

# Ranking Configuration
MAX_RESULTS=10
DISTANCE_THRESHOLD=10.0

# Multi-criteria Ranking Weights
WEIGHT_RELEVANCE=0.4
WEIGHT_RATING=0.25
WEIGHT_DISTANCE=0.20
WEIGHT_POPULARITY=0.15

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=10000

# Redis Configuration (recommended for production)
# REDIS_URL=redis://localhost:6379/0

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Language Configuration
DEFAULT_LANGUAGE=vi
SUPPORTED_LANGUAGES=vi,en

# Data Source
RESTAURANTS_JSON_PATH=/var/lib/chatbot/data/hcm_restaurants_chatbot.json

# Logging - Structured JSON for production monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring Configuration
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# Rate limiting - Strict for production
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_CHAT_PER_MINUTE=30

# CORS - Add your production domains
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
