# =============================================================================
# Food Chatbot Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false  # Set to false in production!

# -----------------------------------------------------------------------------
# Groq Cloud API Configuration
# -----------------------------------------------------------------------------
# Get API keys from: https://console.groq.com/keys
# Multiple keys supported (comma-separated) for load balancing
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3

# Model Configuration (Groq supported models)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_SECONDARY_FALLBACK_MODEL=mixtral-8x7b-32768

# -----------------------------------------------------------------------------
# JWT Authentication Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure secret key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_PATH=./database/chatbot.db

# -----------------------------------------------------------------------------
# Search & Indexing Configuration
# -----------------------------------------------------------------------------
FAISS_INDEX_PATH=./data/faiss_index
BM25_INDEX_PATH=./data/bm25_index.pkl
VECTOR_DIMENSION=384

# Hybrid Search Weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
BM25_WEIGHT=0.4

# Ranking Configuration
MAX_RESULTS=10
DISTANCE_THRESHOLD=10.0

# Multi-criteria Ranking Weights (must sum to 1.0)
WEIGHT_RELEVANCE=0.4
WEIGHT_RATING=0.25
WEIGHT_DISTANCE=0.20
WEIGHT_POPULARITY=0.15

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Optional: Redis Configuration (for distributed caching)
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# -----------------------------------------------------------------------------
# Language Configuration
# -----------------------------------------------------------------------------
DEFAULT_LANGUAGE=vi
SUPPORTED_LANGUAGES=vi,en

# -----------------------------------------------------------------------------
# Data Source Configuration
# -----------------------------------------------------------------------------
RESTAURANTS_JSON_PATH=./hcm_restaurants_chatbot.json

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # Use 'json' for production, 'text' for development

# -----------------------------------------------------------------------------
# Monitoring Configuration (Optional - for production)
# -----------------------------------------------------------------------------
# Sentry Error Tracking
# Get DSN from: https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus Metrics
ENABLE_METRICS=true
PROMETHEUS_ENABLED=true

# Environment (development, staging, production)
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Security Configuration (Optional)
# -----------------------------------------------------------------------------
# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_CHAT_PER_MINUTE=30

# CORS - Add your production domains
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com
