# Frontend
# Can be backend root or backend /api prefix (both supported)
VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000/api

# Optional: dedicated chatbot backend (falls back to VITE_API_BASE_URL if unset)
VITE_CHATBOT_API_URL=http://localhost:8000

# Firebase Authentication (Web app config from Firebase Console)
# If these are not set, the app will fall back to the legacy OTP/JWT auth flow.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
